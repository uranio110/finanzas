# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase
# (Project Settings -> API). La anon key es publica por diseno (ver README) --
# la seguridad real la da Row Level Security, no mantener esto en secreto.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY
